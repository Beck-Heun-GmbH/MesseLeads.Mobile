<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<OutputType>Exe</OutputType>
		<RootNamespace>MesseLeads.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>FoxyLeads</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>de.beckheun.messeleads.mobile</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- 16.4, weil das mitgelieferte llama.xcframework selbst MinimumOSVersion
		     16.4 deklariert. Niedriger gesetzt scheitert dyld beim Start und App
		     Store Connect beanstandet die Diskrepanz. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.4</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- MVVMTK0045 meldet fuer jedes [ObservableProperty]-Feld, dass der
	     generierte Code unter WinRT nicht AOT-faehig ist und eine partielle
	     Property zu bevorzugen waere. Das betrifft ausschliesslich UWP- und
	     WinUI-Szenarien mit AOT. Dieses Projekt liefert iOS und Android aus,
	     das Windows-Ziel dient der lokalen Entwicklung und ist mit
	     WindowsPackageType=None unverpackt und ohne AOT konfiguriert.

	     Die rund hundert Meldungen erschienen nur beim Bauen aller Zielplattformen
	     und haben dort echte Warnungen verdeckt. Sollte das Windows-Ziel je
	     ausgeliefert oder auf AOT umgestellt werden, ist die Unterdrueckung zu
	     entfernen und auf partielle Properties umzustellen. -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
	</PropertyGroup>

	<!-- Increased Memory Limit / Extended Virtual Addressing fuer die lokale
	     llama.cpp-Inferenz. Gilt auch fuer Debug-Geraetebuilds, damit das
	     Speicherverhalten beim Testen dem Release entspricht.

	     Ausdruecklich NICHT fuer Simulatorziele: dort wird ad-hoc signiert, es
	     gibt kein Provisioning Profile, das diese Berechtigungen decken koennte.
	     Mit gesetzten Entitlements bricht das Bereitstellen in den Simulator
	     still ab - der Build laeuft durch, danach passiert schlicht nichts mehr.
	     Ist RuntimeIdentifier leer, greift der Geraetefall.

	     Die Datei heisst bewusst Entitlements.Device.plist und nicht
	     Entitlements.plist: Eine Datei mit letzterem Namen unter Platforms/iOS
	     erkennt das iOS-SDK selbst und setzt CodesignEntitlements fuer *jeden*
	     Build, womit diese Bedingung wirkungslos waere. -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios' And '$(RuntimeIdentifier)' != 'iossimulator-arm64' And '$(RuntimeIdentifier)' != 'iossimulator-x64'">
	  <CodesignEntitlements>Platforms\iOS\Entitlements.Device.plist</CodesignEntitlements>
	</PropertyGroup>

	<!-- App-Store-Signatur, ausschliesslich fuer Release. Debug-Geraetebuilds
	     brauchen ein Development-Profil; wuerden die Werte hier ohne
	     Configuration-Bedingung stehen, scheitert jede Geraeteinstallation mit
	     "ApplicationVerificationFailed", weil ein App-Store-Profil keine
	     Geraeteliste enthaelt.
	
	     IPA erzeugen (Build laeuft ueber Pair to Mac auf dem Mac):
	       dotnet publish MesseLeads.Mobile.csproj -f net10.0-ios -c Release
	
	     Alternativ ein .xcarchive fuer den Xcode Organizer. ArchiveOnBuild
	     gehoert an "dotnet build", nicht an "dotnet publish":
	       dotnet build MesseLeads.Mobile.csproj -f net10.0-ios -c Release -p:ArchiveOnBuild=true
	
	     Den exakten CodesignKey liefert "security find-identity -v -p codesigning". -->
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios' and '$(Configuration)'=='Release'">
		<ProvisioningType>manual</ProvisioningType>
		<CodesignKey>Apple Distribution: Patrick Walther (D2B9G6QAYH)</CodesignKey>
		<CodesignProvision>MesseLeads AppStore</CodesignProvision>
	</PropertyGroup>

	<!-- Ad-Hoc-Build zum Vorfuehren auf registrierten Geraeten. Nicht ueber die
	     VS-Eigenschaftenseite umstellen: VS schreibt das Profil dann in eine
	     PropertyGroup ohne Configuration-Bedingung und ueberschreibt damit still
	     das App-Store-Profil. Stattdessen beim Aufruf uebergeben, Kommandozeilen-
	     Properties gewinnen ohnehin gegen die Projektdatei:
	
	       dotnet build MesseLeads.Mobile.csproj -f net10.0-ios -c Release "-p:CodesignProvision=FoxyLeads AdHoc"
	-->

	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios' and '$(Configuration)'=='Debug'">
	  <MtouchInterpreter>all</MtouchInterpreter>
	  <!-- Debug ueberlaesst Zertifikat und Profil Visual Studio. Mit manueller
	       Bereitstellung verlangt der Build auch fuer Simulatorziele ein Profil,
	       und ein Development-Profil fuer dieses Team gibt es nicht. Release
	       bleibt dagegen fest auf das App-Store-Profil gepinnt. -->
	  <ProvisioningType>automatic</ProvisioningType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(RunConfiguration)'=='Default'">
	  <LaunchForBackgroundFetch>false</LaunchForBackgroundFetch>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#1B3A6B" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\messeleads_splash.svg" Color="#EBF5EC" BaseSize="512,512" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />
		
		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- Das Sprachmodell wird ausschliesslich unter iOS genutzt: ILocalLlmRuntime
	     ist per #if IOS als IosLlamaCppRuntime registriert, alle anderen
	     Plattformen erhalten UnavailableLocalLlmRuntime. Die 1,12 GB werden
	     deshalb nur fuer iOS gepackt.

	     Fuer Android spart das ueber ein Gigabyte totes Gewicht im APK, und der
	     Windows-Build wird damit ueberhaupt erst baubar: MakePRI liest die Punkte
	     im Dateinamen "qwen2.5-1.5b-instruct-q4_k_m.gguf" als Ressourcen-
	     Qualifizierer und bricht mit "PRI249: Invalid qualifier:
	     5B-INSTRUCT-Q4_K_M" ab. -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) != 'ios'">
		<MauiAsset Remove="Resources\Raw\Models\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.90" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.10" />
		<PackageReference Include="sqlite-net-pcl" Version="1.11.285" />
		<PackageReference Include="ZXing.Net.Maui.Controls" Version="0.10.3" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Controls\AppHeaderView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\Wizard\AddressStepView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\Wizard\AnalyzeStepView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\Wizard\BusinessCardAnalysisStepView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\Wizard\ContactStepView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\Wizard\CropImageStepView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\Wizard\LookupGroupStepView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\Wizard\PhotoStepView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\Wizard\QrReviewSetpView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\Wizard\QrScanStepView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Controls\Wizard\SummaryStepView.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ChangePasswordPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\DraftsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\HomePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\LeadWizardPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\LoginPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\NewLeadStartPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\SettingsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\SyncPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>


	<!-- Native llama.cpp is required for iOS builds. Keep this unconditional so
	     missing XCFrameworks fail the build instead of silently using fallback. -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
		<DefineConstants>$(DefineConstants);HAS_LLAMA_NATIVE</DefineConstants>
		<CodesignKey>Apple Distribution: Patrick Walther (D2B9G6QAYH)</CodesignKey>
		<CodesignProvision>MesseLeads AppStore</CodesignProvision>
		<ProvisioningType>manual</ProvisioningType>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
		<NativeReference Include="Platforms\iOS\Native\MesseLeadsLlamaBridge.xcframework">
			<Kind>Framework</Kind>
			<ForceLoad>false</ForceLoad>
			<SmartLink>false</SmartLink>
			<IsCxx>true</IsCxx>
		</NativeReference>

		<NativeReference Include="Platforms\iOS\Native\llama.xcframework">
			<Kind>Framework</Kind>
			<ForceLoad>true</ForceLoad>
			<SmartLink>false</SmartLink>
			<IsCxx>true</IsCxx>
		</NativeReference>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="Documentation\" />
	</ItemGroup>

</Project>
