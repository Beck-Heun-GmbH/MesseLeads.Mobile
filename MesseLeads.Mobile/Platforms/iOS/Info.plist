<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array>
		<integer>1</integer>
		<integer>2</integer>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>MesseLeads benötigt die Kamera, um Visitenkarten zu fotografieren und Kontakt-QR-Codes zu scannen.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>MesseLeads benötigt Zugriff auf Fotos, um Visitenkartenbilder auszuwählen.</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- Export-Compliance: die App nutzt ausschliesslich HTTPS/TLS des Systems
	     und ist damit von der Exportbeschraenkung ausgenommen. Spart die
	     Compliance-Rueckfrage bei jedem Upload nach App Store Connect. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>XSAppIconAssets</key>
	<string>Assets.xcassets/appicon.appiconset</string>
</dict>
</plist>
