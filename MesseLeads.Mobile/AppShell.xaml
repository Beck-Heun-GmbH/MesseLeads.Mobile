<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MesseLeads.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:MesseLeads.Mobile.Views"
    Shell.FlyoutBehavior="Disabled"
    Shell.NavBarIsVisible="False">

    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}" />

    <ShellContent
    Route="change-password"
    ContentTemplate="{DataTemplate views:ChangePasswordPage}" />

    <ShellContent
        Route="trade-fair-selection"
        ContentTemplate="{DataTemplate views:TradeFairSelectionPage}" />

    <ShellContent
        Route="home"
        ContentTemplate="{DataTemplate views:HomePage}" />

</Shell>
