<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MesseLeads.Mobile.Views.ChangePasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:MesseLeads.Mobile.ViewModels"
    x:DataType="viewModels:ChangePasswordViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F7F9F8, Dark=#101614}">

    <Grid>

        <!-- Beck+Heun-Hintergrund -->
        <Grid InputTransparent="True">
            <BoxView
                BackgroundColor="{AppThemeBinding Light=#EBF5EC, Dark=#18231E}"
                HeightRequest="440"
                Rotation="-18"
                TranslationX="-80"
                TranslationY="-130" />

            <BoxView
                BackgroundColor="#BCD5BF"
                WidthRequest="250"
                HeightRequest="850"
                Rotation="42"
                HorizontalOptions="End"
                VerticalOptions="Center"
                TranslationX="130"
                Opacity="{AppThemeBinding Light=0.42, Dark=0.16}" />

            <BoxView
                BackgroundColor="#004D9D"
                WidthRequest="150"
                HeightRequest="520"
                Rotation="42"
                HorizontalOptions="End"
                VerticalOptions="End"
                TranslationX="90"
                TranslationY="110"
                Opacity="{AppThemeBinding Light=0.10, Dark=0.18}" />
        </Grid>

        <ScrollView>
            <Grid
                Padding="{OnIdiom Phone='24,34,24,28',
                                   Tablet='52,54,52,38',
                                   Desktop='56,58,56,42'}"
                RowDefinitions="Auto,*">

                <Image
                    Grid.Row="0"
                    Source="{AppThemeBinding
                        Light=beckheun_logo_light.png,
                        Dark=beckheun_logo_dark.png}"
                    HeightRequest="{OnIdiom Phone=62,
                                             Tablet=86,
                                             Desktop=90}"
                    MaximumWidthRequest="{OnIdiom Phone=280,
                                                  Tablet=390,
                                                  Desktop=410}"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    Margin="0,0,0,28" />

                <Border
                    Grid.Row="1"
                    Padding="{OnIdiom Phone='22,28',
                                      Tablet='42,42',
                                      Desktop='44'}"
                    MaximumWidthRequest="580"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#DCE4DF,
                                             Dark=#46524D}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                      Dark=#1C2522}"
                    StrokeShape="RoundRectangle 28">

                    <Border.Shadow>
                        <Shadow
                            Brush="#000000"
                            Offset="0,10"
                            Radius="28"
                            Opacity="{AppThemeBinding Light=0.16,
                                                     Dark=0.42}" />
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <Border
                            WidthRequest="72"
                            HeightRequest="72"
                            HorizontalOptions="Center"
                            StrokeThickness="6"
                            Stroke="{AppThemeBinding Light=#EBF5EC,
                                                    Dark=#293831}"
                            BackgroundColor="{AppThemeBinding Light=#BCD5BF,
                                                              Dark=#24402E}"
                            StrokeShape="RoundRectangle 36">

                            <Label
                                Text="🔐"
                                FontSize="28"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            Text="Eigenes Passwort festlegen"
                            FontSize="{OnIdiom Phone=28,
                                               Tablet=36,
                                               Desktop=36}"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#111111,
                                                       Dark=#FFFFFF}" />

                        <Label
                            Text="Das vom Server gesetzte Passwort ist nur für die erste Anmeldung bestimmt. Lege jetzt dein persönliches Passwort fest."
                            FontSize="{OnIdiom Phone=15,
                                               Tablet=17,
                                               Desktop=17}"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#69756E,
                                                       Dark=#B9C5BF}"
                            Margin="0,-4,0,10" />

                        <VerticalStackLayout Spacing="7">
                            <Label
                                Text="Neues Passwort"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#394348,
                                                           Dark=#DCE7E1}" />

                            <Border
                                Padding="16,0"
                                HeightRequest="58"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#DCE4DF,
                                                        Dark=#46524D}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                                  Dark=#101614}"
                                StrokeShape="RoundRectangle 14">

                                <Entry
                                    Placeholder="Mindestens 8 Zeichen"
                                    IsPassword="True"
                                    ReturnType="Next"
                                    Text="{Binding NewPassword}" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="7">
                            <Label
                                Text="Passwort wiederholen"
                                FontSize="13"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#394348,
                                                           Dark=#DCE7E1}" />

                            <Border
                                Padding="16,0"
                                HeightRequest="58"
                                StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#DCE4DF,
                                                        Dark=#46524D}"
                                BackgroundColor="{AppThemeBinding Light=#FFFFFF,
                                                                  Dark=#101614}"
                                StrokeShape="RoundRectangle 14">

                                <Entry
                                    Placeholder="Passwort erneut eingeben"
                                    IsPassword="True"
                                    ReturnType="Done"
                                    Text="{Binding ConfirmPassword}" />
                            </Border>
                        </VerticalStackLayout>

                        <Border
                            Padding="14"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#CD1719,
                                                    Dark=#FF8D8D}"
                            BackgroundColor="{AppThemeBinding Light=#FFF1F1,
                                                              Dark=#351B1B}"
                            StrokeShape="RoundRectangle 12"
                            IsVisible="{Binding HasError}">

                            <Label
                                Text="{Binding ErrorText}"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light=#CD1719,
                                                           Dark=#FF8D8D}" />
                        </Border>

                        <Button
                            Text="Passwort speichern"
                            Command="{Binding SaveCommand}"
                            IsEnabled="{Binding IsBusy,
                                Converter={StaticResource InvertedBoolConverter}}"
                            Margin="0,6,0,0" />

                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            Color="#004D9D" />

                        <Label
                            Text="Das Passwort wird sicher auf dem Server gespeichert."
                            FontSize="12"
                            HorizontalTextAlignment="Center"
                            TextColor="{AppThemeBinding Light=#69756E,
                                                       Dark=#AEBDB4}" />

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>