<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MesseLeads.Mobile.Views.TradeFairSelectionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:MesseLeads.Mobile.ViewModels"
    xmlns:models="clr-namespace:MesseLeads.Mobile.Models"
    x:DataType="viewModels:TradeFairSelectionViewModel"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light=#F7F9F8, Dark=#101614}">

    <Grid>
        <Grid InputTransparent="True">
            <BoxView
                BackgroundColor="{AppThemeBinding Light=#EBF5EC, Dark=#18231E}"
                HeightRequest="420"
                Rotation="-18"
                TranslationY="-135"
                TranslationX="-90" />

            <BoxView
                BackgroundColor="#BCD5BF"
                WidthRequest="250"
                HeightRequest="820"
                Rotation="42"
                HorizontalOptions="End"
                VerticalOptions="End"
                TranslationX="130"
                TranslationY="110"
                Opacity="{AppThemeBinding Light=0.38, Dark=0.14}" />
        </Grid>

        <ScrollView>
            <Grid
                RowDefinitions="Auto,*,Auto"
                Padding="{OnIdiom Phone='24,28,24,26', Tablet='52,44,52,34', Desktop='56'}">

                <Image
                    Grid.Row="0"
                    Source="{AppThemeBinding Light=beckheun_logo_light.png, Dark=beckheun_logo_dark.png}"
                    HeightRequest="{OnIdiom Phone=58, Tablet=78, Desktop=82}"
                    MaximumWidthRequest="{OnIdiom Phone=270, Tablet=390, Desktop=410}"
                    Aspect="AspectFit"
                    HorizontalOptions="Center"
                    Margin="0,0,0,26" />

                <Border
                    Grid.Row="1"
                    Padding="{OnIdiom Phone='22,26', Tablet='38,38', Desktop='40'}"
                    MaximumWidthRequest="620"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    StrokeThickness="1"
                    Stroke="{AppThemeBinding Light=#DCE4DF, Dark=#46524D}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C2522}"
                    StrokeShape="RoundRectangle 28">

                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                Text="Messe auswählen"
                                FontSize="{OnIdiom Phone=32, Tablet=40, Desktop=40}"
                                FontAttributes="Bold"
                                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                            <Label
                                Text="{Binding StatusText}"
                                FontSize="15"
                                TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                        </VerticalStackLayout>

                        <ActivityIndicator
                            IsVisible="{Binding IsBusy}"
                            IsRunning="{Binding IsBusy}"
                            Color="#004D9D" />

                        <Border
                            Padding="12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light=#E2E9E5, Dark=#3B4742}"
                            BackgroundColor="{AppThemeBinding Light=#F8FAF9, Dark=#17211E}"
                            StrokeShape="RoundRectangle 16"
                            IsVisible="{Binding HasNoTradeFairs}">

                            <Label
                                Text="Keine Messe verfügbar. Prüfe Verbindung und Server, oder lade erneut."
                                FontSize="14"
                                TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                        </Border>

                        <CollectionView
                            IsVisible="{Binding HasTradeFairs}"
                            ItemsSource="{Binding TradeFairs}"
                            SelectedItem="{Binding SelectedTradeFair, Mode=TwoWay}"
                            SelectionMode="Single"
                            HeightRequest="{OnIdiom Phone=190, Tablet=240, Desktop=260}">

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:TradeFairSelection">
                                    <Border
                                        Margin="0,0,0,10"
                                        Padding="16"
                                        StrokeThickness="1"
                                        Stroke="{AppThemeBinding Light=#DCE4DF, Dark=#46524D}"
                                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#101614}"
                                        StrokeShape="RoundRectangle 16">

                                        <VerticalStackLayout Spacing="2">
                                            <Label
                                                Text="{Binding Label}"
                                                FontSize="17"
                                                FontAttributes="Bold"
                                                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

                                            <Label
                                                Text="{Binding Key}"
                                                FontSize="13"
                                                TextColor="#004D9D" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Button
                                Text="Aktualisieren"
                                BackgroundColor="{AppThemeBinding Light=#EEF1EF, Dark=#26312D}"
                                TextColor="{AppThemeBinding Light=#394348, Dark=#FFFFFF}"
                                Command="{Binding RefreshCommand}" />

                            <Button
                                Grid.Column="1"
                                Text="Messe übernehmen"
                                IsEnabled="{Binding CanConfirm}"
                                Command="{Binding ConfirmCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>
    </Grid>
</ContentPage>
