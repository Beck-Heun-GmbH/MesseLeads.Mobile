<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="MesseLeads.Mobile.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:MesseLeads.Mobile.Converters">

    <Application.Resources>
        <ResourceDictionary>

            <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" />
            <converters:SelectionBackgroundConverter x:Key="SelectionBackgroundConverter" />

            <Color x:Key="BhBlue">#004D9D</Color>
            <Color x:Key="BhRed">#CD1719</Color>
            <Color x:Key="BhGreen">#BCD5BF</Color>
            <Color x:Key="BhGreenLight">#EBF5EC</Color>
            <Color x:Key="BhGray">#394348</Color>

            <Color x:Key="BhDarkBackground">#101614</Color>
            <Color x:Key="BhDarkCard">#1C2522</Color>

            <Style TargetType="Button">
                <Setter Property="HeightRequest" Value="56" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="BackgroundColor" Value="{StaticResource BhBlue}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="FontSize" Value="17" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="TextColor" Value="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
                <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light=#7A827D, Dark=#94A39A}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>