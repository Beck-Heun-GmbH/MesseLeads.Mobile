<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MesseLeads.Mobile.Controls.Wizard.AddressStepView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Padding="20"
        StrokeThickness="1"
        Stroke="{AppThemeBinding Light=#DCE4DF, Dark=#46524D}"
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C2522}"
        StrokeShape="RoundRectangle 24">

        <VerticalStackLayout Spacing="16">

            <Label
                Text="Adresse"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />
<!-- TEST -->
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Straße und Hausnummer"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="Straße und Hausnummer eingeben"
                    Text="{Binding Street}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="PLZ"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="Postleitzahl eingeben"
                    Keyboard="Numeric"
                    Text="{Binding ZipCode}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Ort"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="Ort eingeben"
                    Text="{Binding City}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Land"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="Land eingeben"
                    Text="{Binding Country}" />
            </VerticalStackLayout>

        </VerticalStackLayout>

    </Border>

</ContentView>
