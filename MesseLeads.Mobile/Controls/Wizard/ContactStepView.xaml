<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="MesseLeads.Mobile.Controls.Wizard.ContactStepView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Border
        Padding="20"
        StrokeThickness="1"
        Stroke="{AppThemeBinding Light=#DCE4DF, Dark=#46524D}"
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C2522}"
        StrokeShape="RoundRectangle 24">

        <VerticalStackLayout Spacing="16">

            <Label
                Text="Kontaktdaten"
                FontSize="21"
                FontAttributes="Bold"
                TextColor="{AppThemeBinding Light=#111111, Dark=#FFFFFF}" />

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Vorname"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="Vorname eingeben"
                    Text="{Binding FirstName}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Nachname"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="Nachname eingeben"
                    Text="{Binding LastName}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Firma"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="Firma eingeben"
                    Text="{Binding Company}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Position"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="Position eingeben"
                    Text="{Binding JobTitle}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="E-Mail"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="E-Mail-Adresse eingeben"
                    Keyboard="Email"
                    Text="{Binding Email}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Telefon"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="Telefonnummer eingeben"
                    Keyboard="Telephone"
                    Text="{Binding Phone}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Mobil"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="Mobilnummer eingeben"
                    Keyboard="Telephone"
                    Text="{Binding Mobile}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="6">
                <Label
                    Text="Webseite"
                    FontSize="13"
                    FontAttributes="Bold"
                    TextColor="{AppThemeBinding Light=#69756E, Dark=#B9C5BF}" />
                <Entry
                    Placeholder="Webseite eingeben"
                    Keyboard="Url"
                    Text="{Binding Website}" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </Border>
</ContentView>
